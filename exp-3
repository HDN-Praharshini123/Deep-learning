        "\n",
        "# CO1 – Mathematical Foundations and Optimization\n",
        "# Experiment 3: Probability Distributions and Bayes' Theorem\n",
        "\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from scipy.stats import bernoulli, binom, poisson, uniform, norm\n",
        "\n",
        "np.random.seed(42)\n",
        "\n",
        "# --------------------------------------------------\n",
        "# Task 1: Generate and Plot Probability Distributions\n",
        "# --------------------------------------------------\n",
        "\n",
        "sample_size = 10000\n",
        "\n",
        "# 1. Bernoulli Distribution\n",
        "p_bernoulli = 0.4\n",
        "bernoulli_data = bernoulli.rvs(p_bernoulli, size=sample_size)\n",
        "\n",
        "# 2. Binomial Distribution\n",
        "n_binomial = 10\n",
        "p_binomial = 0.5\n",
        "binomial_data = binom.rvs(\n",
        "    n=n_binomial, p=p_binomial, size=sample_size\n",
        ")\n",
        "\n",
        "# 3. Poisson Distribution\n",
        "lambda_poisson = 4\n",
        "poisson_data = poisson.rvs(\n",
        "    mu=lambda_poisson, size=sample_size\n",
        ")\n",
        "\n",
        "# 4. Uniform Distribution\n",
        "a, b = 0, 10\n",
        "uniform_data = uniform.rvs(\n",
        "    loc=a, scale=b-a, size=sample_size\n",
        ")\n",
        "\n",
        "# 5. Gaussian (Normal) Distribution\n",
        "mean, std = 50, 10\n",
        "gaussian_data = norm.rvs(\n",
        "    loc=mean, scale=std, size=sample_size\n",
        ")\n",
        "\n",
        "# Plot all five distributions\n",
        "fig, axes = plt.subplots(2, 3, figsize=(15, 9))\n",
        "axes = axes.flatten()\n",
        "\n",
        "# Bernoulli: theoretical PMF vs empirical probabilities\n",
        "x = np.array([0, 1])\n",
        "axes[0].bar(\n",
        "    x - 0.15,\n",
        "    bernoulli.pmf(x, p_bernoulli),\n",
        "    width=0.3,\n",
        "    label=\"Theoretical PMF\"\n",
        ")\n",
        "axes[0].bar(\n",
        "    x + 0.15,\n",
        "    [np.mean(bernoulli_data == 0),\n",
        "     np.mean(bernoulli_data == 1)],\n",
        "    width=0.3,\n",
        "    label=\"Empirical\"\n",
        ")\n",
        "axes[0].set_title(\"Bernoulli Distribution\")\n",
        "axes[0].set_xticks(x)\n",
        "axes[0].legend()\n",
        "\n",
        "# Binomial: theoretical PMF vs empirical probabilities\n",
        "x = np.arange(n_binomial + 1)\n",
        "axes[1].bar(\n",
        "    x - 0.15,\n",
        "    binom.pmf(x, n_binomial, p_binomial),\n",
        "    width=0.3,\n",
        "    label=\"Theoretical PMF\"\n",
        ")\n",
        "axes[1].bar(\n",
        "    x + 0.15,\n",
        "    [np.mean(binomial_data == k) for k in x],\n",
        "    width=0.3,\n",
        "    label=\"Empirical\"\n",
        ")\n",
        "axes[1].set_title(\"Binomial Distribution\")\n",
        "axes[1].legend()\n",
        "\n",
        "# Poisson: theoretical PMF vs empirical probabilities\n",
        "x = np.arange(0, 15)\n",
        "axes[2].bar(\n",
        "    x - 0.15,\n",
        "    poisson.pmf(x, lambda_poisson),\n",
        "    width=0.3,\n",
        "    label=\"Theoretical PMF\"\n",
        ")\n",
        "axes[2].bar(\n",
        "    x + 0.15,\n",
        "    [np.mean(poisson_data == k) for k in x],\n",
        "    width=0.3,\n",
        "    label=\"Empirical\"\n",
        ")\n",
        "axes[2].set_title(\"Poisson Distribution\")\n",
        "axes[2].legend()\n",
        "\n",
        "# Uniform: histogram vs theoretical PDF\n",
        "axes[3].hist(\n",
        "    uniform_data, bins=30, density=True,\n",
        "    alpha=0.6, label=\"Sample Histogram\"\n",
        ")\n",
        "x_cont = np.linspace(a, b, 200)\n",
        "axes[3].plot(\n",
        "    x_cont,\n",
        "    uniform.pdf(x_cont, loc=a, scale=b-a),\n",
        "    linewidth=2,\n",
        "    label=\"Theoretical PDF\"\n",
        ")\n",
        "axes[3].set_title(\"Uniform Distribution\")\n",
        "axes[3].legend()\n",
        "\n",
        "# Gaussian: histogram vs theoretical PDF\n",
        "axes[4].hist(\n",
        "    gaussian_data, bins=40, density=True,\n",
        "    alpha=0.6, label=\"Sample Histogram\"\n",
        ")\n",
        "x_cont = np.linspace(mean - 4*std, mean + 4*std, 300)\n",
        "axes[4].plot(\n",
        "    x_cont,\n",
        "    norm.pdf(x_cont, loc=mean, scale=std),\n",
        "    linewidth=2,\n",
        "    label=\"Theoretical PDF\"\n",
        ")\n",
        "axes[4].set_title(\"Gaussian (Normal) Distribution\")\n",
        "axes[4].legend()\n",
        "\n",
        "axes[5].axis(\"off\")\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "print(\"Task 1 completed: All five distributions plotted.\")\n",
        "\n",
        "\n",
        "# --------------------------------------------------\n",
        "# Task 2: Bayes' Theorem\n",
        "# --------------------------------------------------\n",
        "\n",
        "prevalence = 0.01       # P(Disease) = 1%\n",
        "sensitivity = 0.95      # P(Positive | Disease) = 95%\n",
        "specificity = 0.90      # P(Negative | No Disease) = 90%\n",
        "\n",
        "# False positive rate\n",
        "false_positive_rate = 1 - specificity\n",
        "\n",
        "# Bayes' theorem\n",
        "p_positive = (\n",
        "    sensitivity * prevalence\n",
        "    + false_positive_rate * (1 - prevalence)\n",
        ")\n",
        "\n",
        "posterior = (\n",
        "    sensitivity * prevalence\n",
        ") / p_positive\n",
        "\n",
        "print(\"\\nTask 2: Bayes' Theorem\")\n",
        "print(f\"Disease prevalence: {prevalence * 100:.2f}%\")\n",
        "print(f\"Sensitivity: {sensitivity * 100:.2f}%\")\n",
        "print(f\"Specificity: {specificity * 100:.2f}%\")\n",
        "print(f\"Probability of a positive test: {p_positive:.4f}\")\n",
        "print(\n",
        "    f\"P(Disease | Positive) = {posterior:.4f}\"\n",
        ")\n",
        "print(\n",
        "    f\"Posterior probability = {posterior * 100:.2f}%\"\n",
        ")\n",
        "\n",
        "\n",
        "# --------------------------------------------------\n",
        "# Task 3: Simulate 100,000 Patients\n",
        "# --------------------------------------------------\n",
        "\n",
        "number_of_patients = 100000\n",
        "\n",
        "# Generate whether each patient has the disease\n",
        "disease_status = (\n",
        "    np.random.random(number_of_patients) < prevalence\n",
        ")\n",
        "\n",
        "# Generate positive test results based on disease status\n",
        "test_positive = np.zeros(number_of_patients, dtype=bool)\n",
        "\n",
        "# Diseased patients test positive according to sensitivity\n",
        "test_positive[disease_status] = (\n",
        "    np.random.random(np.sum(disease_status)) < sensitivity\n",
        ")\n",
        "\n",
        "# Healthy patients test positive according to false positive rate\n",
        "healthy = ~disease_status\n",
        "test_positive[healthy] = (\n",
        "    np.random.random(np.sum(healthy)) < false_positive_rate\n",
        ")\n",
        "\n",
        "# Empirical probability among positive test results\n",
        "total_positive = np.sum(test_positive)\n",
        "true_positive = np.sum(test_positive & disease_status)\n",
        "\n",
        "empirical_posterior = (\n",
        "    true_positive / total_positive\n",
        "    if total_positive > 0 else 0\n",
        ")\n",
        "\n",
        "print(\"\\nTask 3: Simulation Results\")\n",
        "print(f\"Total patients: {number_of_patients}\")\n",
        "print(f\"Patients with disease: {np.sum(disease_status)}\")\n",
        "print(f\"Positive test results: {total_positive}\")\n",
        "print(f\"True positive results: {true_positive}\")\n",
        "print(\n",
        "    f\"Theoretical posterior: {posterior * 100:.2f}%\"\n",
        ")\n",
        "print(\n",
        "    f\"Empirical posterior: {empirical_posterior * 100:.2f}%\"\n",
        ")\n",
        "\n",
        "\n",
        "# Compare theoretical and empirical probabilities\n",
        "plt.figure(figsize=(7, 5))\n",
        "\n",
        "plt.bar(\n",
        "    [\"Theoretical\", \"Simulation\"],\n",
        "    [posterior * 100, empirical_posterior * 100]\n",
        ")\n",
        "\n",
        "plt.ylabel(\"Probability of Disease Given Positive (%)\")\n",
        "plt.title(\"Bayes' Theorem: Theoretical vs Simulation\")\n",
        "plt.grid(axis=\"y\", alpha=0.3)\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# --------------------------------------------------\n",
        "# Task 4: Posterior Probability vs Disease Prevalence\n",
        "# --------------------------------------------------\n",
        "\n",
        "prevalences = np.linspace(0.001, 0.20, 200)\n",
        "\n",
        "posterior_values = (\n",
        "    sensitivity * prevalences\n",
        ") / (\n",
        "    sensitivity * prevalences\n",
        "    + (1 - specificity) * (1 - prevalences)\n",
        ")\n",
        "\n",
        "plt.figure(figsize=(9, 5))\n",
        "\n",
        "plt.plot(\n",
        "    prevalences * 100,\n",
        "    posterior_values * 100,\n",
        "    linewidth=2\n",
        ")\n",
        "\n",
        "plt.scatter(\n",
        "    [prevalence * 100],\n",
        "    [posterior * 100],\n",
        "    color=\"red\",\n",
        "    label=\"Given prevalence = 1%\"\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Disease Prevalence (%)\")\n",
        "plt.ylabel(\"P(Disease | Positive) (%)\")\n",
        "plt.title(\"Effect of Disease Prevalence on Posterior Probability\")\n",
        "plt.grid(True, alpha=0.3)\n",
        "plt.legend()\n",
        "plt.show()\n",
        "\n",
        "print(\"\\nPosterior probabilities at selected prevalences:\")\n",
        "\n",
        "for prev in [0.001, 0.01, 0.05, 0.10, 0.20]:\n",
        "    post = (\n",
        "        sensitivity * prev\n",
        "    ) / (\n",
        "        sensitivity * prev\n",
        "        + (1 - specificity) * (1 - prev)\n",
        "    )\n",
        "    print(\n",
        "        f\"Prevalence = {prev*100:5.1f}% \"\n",
        "        f\"--> Posterior = {post*100:6.2f}%\"\n",
        "    )\n",
        "\n",
        "print(\"\\nExperiment 3 completed successfully!\")\n"
      ]
    }
