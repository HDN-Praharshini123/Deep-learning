        "\n",
        "# CO1 – Mathematical Foundations and Optimization\n",
        "# Experiment 1: Vector and Matrix Operations for Deep Learning\n",
        "\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# --------------------------------------------------\n",
        "# Task 1: Build Customer-Genre and Genre-Book Matrices\n",
        "# --------------------------------------------------\n",
        "\n",
        "# 6 customers and 5 genres\n",
        "# Columns: Fiction, Mystery, Romance, Science, History\n",
        "\n",
        "customer_genre = np.array([\n",
        "    [5, 4, 1, 2, 3],\n",
        "    [4, 5, 1, 2, 2],\n",
        "    [1, 2, 5, 3, 2],\n",
        "    [2, 1, 4, 5, 3],\n",
        "    [3, 2, 2, 5, 4],\n",
        "    [5, 3, 2, 1, 4]\n",
        "], dtype=float)\n",
        "\n",
        "# 5 genres and 4 books\n",
        "# Columns: Book A, Book B, Book C, Book D\n",
        "\n",
        "genre_book = np.array([\n",
        "    [0.9, 0.2, 0.1, 0.5],\n",
        "    [0.8, 0.3, 0.2, 0.4],\n",
        "    [0.1, 0.9, 0.3, 0.2],\n",
        "    [0.2, 0.4, 0.9, 0.3],\n",
        "    [0.3, 0.2, 0.4, 0.8]\n",
        "], dtype=float)\n",
        "\n",
        "print(\"Customer-Genre Matrix (6x5):\")\n",
        "print(customer_genre)\n",
        "\n",
        "print(\"\\nGenre-Book Matrix (5x4):\")\n",
        "print(genre_book)\n",
        "\n",
        "\n",
        "# --------------------------------------------------\n",
        "# Task 2: Vector and Matrix Operations\n",
        "# --------------------------------------------------\n",
        "\n",
        "# Dot product of the first customer and first book\n",
        "dot_product = np.dot(customer_genre[0], genre_book[:, 0])\n",
        "print(\"\\nDot Product (Customer 1 and Book A):\")\n",
        "print(dot_product)\n",
        "\n",
        "# Matrix multiplication: customer-book scores\n",
        "score_matrix = np.matmul(customer_genre, genre_book)\n",
        "print(\"\\nCustomer-Book Score Matrix (6x4):\")\n",
        "print(score_matrix)\n",
        "\n",
        "# Transpose\n",
        "print(\"\\nTranspose of Customer-Genre Matrix:\")\n",
        "print(customer_genre.T)\n",
        "\n",
        "# Inverse of a square matrix (where valid)\n",
        "square_matrix = np.array([\n",
        "    [2, 1],\n",
        "    [1, 2]\n",
        "], dtype=float)\n",
        "\n",
        "print(\"\\nSquare Matrix:\")\n",
        "print(square_matrix)\n",
        "\n",
        "print(\"\\nInverse of Square Matrix:\")\n",
        "print(np.linalg.inv(square_matrix))\n",
        "\n",
        "# Element-wise operations\n",
        "print(\"\\nElement-wise Addition (Customer-Genre + 1):\")\n",
        "print(customer_genre + 1)\n",
        "\n",
        "print(\"\\nElement-wise Multiplication (Customer-Genre * 2):\")\n",
        "print(customer_genre * 2)\n",
        "\n",
        "print(\"\\nElement-wise Squaring:\")\n",
        "print(np.square(customer_genre))\n",
        "\n",
        "\n",
        "# --------------------------------------------------\n",
        "# Task 3: Cosine Similarity Between Customers\n",
        "# --------------------------------------------------\n",
        "\n",
        "# Normalize customer vectors and calculate cosine similarity\n",
        "norms = np.linalg.norm(customer_genre, axis=1, keepdims=True)\n",
        "normalized = customer_genre / norms\n",
        "\n",
        "cosine_similarity = normalized @ normalized.T\n",
        "\n",
        "print(\"\\nCustomer Cosine Similarity Matrix:\")\n",
        "print(np.round(cosine_similarity, 3))\n",
        "\n",
        "# Ignore self-similarity along the diagonal\n",
        "similarity_without_diagonal = cosine_similarity.copy()\n",
        "np.fill_diagonal(similarity_without_diagonal, -1)\n",
        "\n",
        "# Find the most similar pair\n",
        "i, j = np.unravel_index(\n",
        "    np.argmax(similarity_without_diagonal),\n",
        "    similarity_without_diagonal.shape\n",
        ")\n",
        "\n",
        "print(f\"\\nMost Similar Customers: Customer {i+1} and Customer {j+1}\")\n",
        "print(f\"Cosine Similarity: {cosine_similarity[i, j]:.4f}\")\n",
        "\n",
        "\n",
        "# --------------------------------------------------\n",
        "# Task 4: Dense Layer Calculation: y = Wx + b\n",
        "# --------------------------------------------------\n",
        "\n",
        "# Use Customer 1 as the input vector\n",
        "x = customer_genre[0]\n",
        "\n",
        "# Weight matrix: 3 output neurons and 5 input features\n",
        "W = np.array([\n",
        "    [0.2, 0.1, 0.3, 0.4, 0.1],\n",
        "    [0.5, 0.2, 0.1, 0.3, 0.2],\n",
        "    [0.1, 0.4, 0.2, 0.1, 0.5]\n",
        "])\n",
        "\n",
        "# Bias for each output neuron\n",
        "b = np.array([0.5, 0.2, 0.3])\n",
        "\n",
        "# Manual calculation using NumPy operations\n",
        "Wx = W @ x\n",
        "y = Wx + b\n",
        "\n",
        "print(\"\\nDense Layer Calculation\")\n",
        "print(\"Input x:\", x)\n",
        "print(\"Weight Matrix W:\\n\", W)\n",
        "print(\"Bias b:\", b)\n",
        "print(\"Wx:\", Wx)\n",
        "print(\"Final Output y = Wx + b:\", y)\n",
        "\n",
        "\n",
        "# --------------------------------------------------\n",
        "# Task 5: Visualize Customer-Book Scores as a Heatmap\n",
        "# --------------------------------------------------\n",
        "\n",
        "plt.figure(figsize=(9, 5))\n",
        "\n",
        "plt.imshow(score_matrix, cmap=\"YlGnBu\", aspect=\"auto\")\n",
        "plt.colorbar(label=\"Recommendation Score\")\n",
        "\n",
        "plt.xticks(\n",
        "    ticks=np.arange(4),\n",
        "    labels=[\"Book A\", \"Book B\", \"Book C\", \"Book D\"]\n",
        ")\n",
        "\n",
        "plt.yticks(\n",
        "    ticks=np.arange(6),\n",
        "    labels=[f\"Customer {i}\" for i in range(1, 7)]\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Books\")\n",
        "plt.ylabel(\"Customers\")\n",
        "plt.title(\"Customer-Book Recommendation Score Heatmap\")\n",
        "\n",
        "# Display the numerical score in each cell\n",
        "for row in range(score_matrix.shape[0]):\n",
        "    for col in range(score_matrix.shape[1]):\n",
        "        plt.text(\n",
        "            col, row,\n",
        "            f\"{score_matrix[row, col]:.1f}\",\n",
        "            ha=\"center\",\n",
        "            va=\"center\",\n",
        "            color=\"black\"\n",
        "        )\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "print(\"\\nExperiment 1 completed successfully!\")\n"
      ]
