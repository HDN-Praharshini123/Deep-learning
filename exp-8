        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.datasets import make_moons\n",
        "\n",
        "np.random.seed(42)\n",
        "\n",
        "# Task 1: Generate XOR data and initialize weights\n",
        "X = np.array([[0,0],[0,1],[1,0],[1,1]])\n",
        "y = np.array([[0],[1],[1],[0]])\n",
        "\n",
        "W1 = np.random.randn(2, 4) * 0.5\n",
        "b1 = np.zeros((1, 4))\n",
        "W2 = np.random.randn(4, 1) * 0.5\n",
        "b2 = np.zeros((1, 1))\n",
        "\n",
        "def sigmoid(z):\n",
        "    return 1 / (1 + np.exp(-np.clip(z, -500, 500)))\n",
        "\n",
        "# Task 2: Forward propagation\n",
        "def forward(X):\n",
        "    h = sigmoid(X @ W1 + b1)\n",
        "    o = sigmoid(h @ W2 + b2)\n",
        "    return h, o\n",
        "\n",
        "# Task 3 & 4: Backpropagation and gradient descent\n",
        "lr = 1.0\n",
        "losses = []\n",
        "\n",
        "for epoch in range(10000):\n",
        "    h, o = forward(X)\n",
        "    loss = -np.mean(y*np.log(o+1e-9) +\n",
        "                    (1-y)*np.log(1-o+1e-9))\n",
        "    losses.append(loss)\n",
        "\n",
        "    # Backward pass: chain rule\n",
        "    d2 = (o-y) / len(X)\n",
        "    gW2 = h.T @ d2\n",
        "    gb2 = np.sum(d2, axis=0, keepdims=True)\n",
        "\n",
        "    d1 = (d2 @ W2.T) * h * (1-h)\n",
        "    gW1 = X.T @ d1\n",
        "    gb1 = np.sum(d1, axis=0, keepdims=True)\n",
        "\n",
        "    W1 -= lr * gW1\n",
        "    b1 -= lr * gb1\n",
        "    W2 -= lr * gW2\n",
        "    b2 -= lr * gb2\n",
        "\n",
        "print(\"XOR predictions:\", (forward(X)[1] >= 0.5).astype(int).ravel())\n",
        "\n",
        "# Plot loss\n",
        "plt.plot(losses)\n",
        "plt.xlabel(\"Epoch\")\n",
        "plt.ylabel(\"Loss\")\n",
        "plt.title(\"Training Loss\")\n",
        "plt.grid()\n",
        "plt.show()\n",
        "\n",
        "# Task 5: Non-linear decision boundary using two-moons data\n",
        "Xm, ym = make_moons(n_samples=200, noise=0.15, random_state=42)\n",
        "ym = ym.reshape(-1, 1)\n",
        "\n",
        "# Train the same network on two-moons data\n",
        "W1 = np.random.randn(2, 8) * 0.5\n",
        "b1 = np.zeros((1, 8))\n",
        "W2 = np.random.randn(8, 1) * 0.5\n",
        "b2 = np.zeros((1, 1))\n",
        "losses = []\n",
        "\n",
        "for epoch in range(5000):\n",
        "    h, o = forward(Xm)\n",
        "    loss = -np.mean(ym*np.log(o+1e-9) +\n",
        "                    (1-ym)*np.log(1-o+1e-9))\n",
        "    losses.append(loss)\n",
        "\n",
        "    d2 = (o-ym) / len(Xm)\n",
        "    gW2 = h.T @ d2\n",
        "    gb2 = d2.sum(axis=0, keepdims=True)\n",
        "    d1 = (d2 @ W2.T) * h * (1-h)\n",
        "    gW1 = Xm.T @ d1\n",
        "    gb1 = d1.sum(axis=0, keepdims=True)\n",
        "\n",
        "    W1 -= 0.5*gW1\n",
        "    b1 -= 0.5*gb1\n",
        "    W2 -= 0.5*gW2\n",
        "    b2 -= 0.5*gb2\n",
        "\n",
        "# Decision boundary\n",
        "xx, yy = np.meshgrid(\n",
        "    np.linspace(Xm[:,0].min()-0.5, Xm[:,0].max()+0.5, 150),\n",
        "    np.linspace(Xm[:,1].min()-0.5, Xm[:,1].max()+0.5, 150)\n",
        ")\n",
        "grid = np.c_[xx.ravel(), yy.ravel()]\n",
        "Z = forward(grid)[1].reshape(xx.shape)\n",
        "\n",
        "plt.contourf(xx, yy, Z, levels=[0,0.5,1], alpha=0.3)\n",
        "plt.contour(xx, yy, Z, levels=[0.5], colors='black')\n",
        "plt.scatter(Xm[:,0], Xm[:,1], c=ym.ravel())\n",
        "plt.title(\"Two-Moons Decision Boundary\")\n",
        "plt.show()\n",
        "\n",
        "# Numerical gradient check for one weight\n",
        "h, o = forward(X)\n",
        "d2 = (o-y)/len(X)\n",
        "d1 = (d2 @ W2.T)*h*(1-h)\n",
        "gW1 = X.T @ d1\n",
        "\n",
        "eps = 1e-5\n",
        "original = W1[0,0]\n",
        "W1[0,0] = original + eps\n",
        "lp = -np.mean(y*np.log(forward(X)[1]+1e-9) +\n",
        "              (1-y)*np.log(1-forward(X)[1]+1e-9))\n",
        "W1[0,0] = original - eps\n",
        "lm = -np.mean(y*np.log(forward(X)[1]+1e-9) +\n",
        "              (1-y)*np.log(1-forward(X)[1]+1e-9))\n",
        "W1[0,0] = original\n",
        "\n",
        "print(\"Numerical gradient:\", (lp-lm)/(2*eps))\n",
        "print(\"Analytical gradient:\", gW1[0,0])"
      ]
