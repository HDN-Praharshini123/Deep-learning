        "\n",
        "# CO1 – Mathematical Foundations and Optimization\n",
        "# Experiment 5: Bias–Variance, Overfitting and Underfitting Analysis\n",
        "\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "from sklearn.preprocessing import PolynomialFeatures\n",
        "from sklearn.linear_model import LinearRegression\n",
        "from sklearn.pipeline import make_pipeline\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.metrics import mean_squared_error\n",
        "from sklearn.utils import resample\n",
        "\n",
        "# --------------------------------------------------\n",
        "# Task 1: Generate 150 Noisy House-Price Samples\n",
        "# --------------------------------------------------\n",
        "\n",
        "np.random.seed(42)\n",
        "\n",
        "# House area in square feet\n",
        "X = np.linspace(500, 3000, 150).reshape(-1, 1)\n",
        "\n",
        "# Hidden nonlinear relationship between area and price\n",
        "y = (\n",
        "    50000\n",
        "    + 100 * X.ravel()\n",
        "    + 0.025 * (X.ravel() ** 2)\n",
        "    + 150000 * np.sin(X.ravel() / 500)\n",
        "    + np.random.normal(0, 50000, 150)\n",
        ")\n",
        "\n",
        "# Split into training and validation sets\n",
        "X_train, X_val, y_train, y_val = train_test_split(\n",
        "    X, y, test_size=0.25, random_state=42\n",
        ")\n",
        "\n",
        "print(\"Total samples:\", len(X))\n",
        "print(\"Training samples:\", len(X_train))\n",
        "print(\"Validation samples:\", len(X_val))\n",
        "\n",
        "\n",
        "# --------------------------------------------------\n",
        "# Task 2: Fit Polynomial Regression Models\n",
        "# Degrees 1, 3, 9 and 15\n",
        "# --------------------------------------------------\n",
        "\n",
        "degrees = [1, 3, 9, 15]\n",
        "models = {}\n",
        "\n",
        "X_plot = np.linspace(500, 3000, 300).reshape(-1, 1)\n",
        "\n",
        "plt.figure(figsize=(12, 7))\n",
        "\n",
        "plt.scatter(\n",
        "    X_train, y_train,\n",
        "    color=\"blue\", alpha=0.6, label=\"Training Data\"\n",
        ")\n",
        "\n",
        "plt.scatter(\n",
        "    X_val, y_val,\n",
        "    color=\"orange\", alpha=0.6, label=\"Validation Data\"\n",
        ")\n",
        "\n",
        "for degree in degrees:\n",
        "    model = make_pipeline(\n",
        "        PolynomialFeatures(degree=degree),\n",
        "        LinearRegression()\n",
        "    )\n",
        "\n",
        "    model.fit(X_train, y_train)\n",
        "    models[degree] = model\n",
        "\n",
        "    y_plot = model.predict(X_plot)\n",
        "\n",
        "    plt.plot(\n",
        "        X_plot, y_plot,\n",
        "        linewidth=2,\n",
        "        label=f\"Polynomial Degree {degree}\"\n",
        "    )\n",
        "\n",
        "plt.xlabel(\"House Area (sq. ft.)\")\n",
        "plt.ylabel(\"House Price\")\n",
        "plt.title(\"Polynomial Regression: Underfitting and Overfitting\")\n",
        "plt.legend()\n",
        "plt.grid(alpha=0.3)\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# --------------------------------------------------\n",
        "# Task 3: Training and Validation Error\n",
        "# --------------------------------------------------\n",
        "\n",
        "training_errors = []\n",
        "validation_errors = []\n",
        "\n",
        "for degree in degrees:\n",
        "    model = models[degree]\n",
        "\n",
        "    train_predictions = model.predict(X_train)\n",
        "    val_predictions = model.predict(X_val)\n",
        "\n",
        "    train_mse = mean_squared_error(y_train, train_predictions)\n",
        "    val_mse = mean_squared_error(y_val, val_predictions)\n",
        "\n",
        "    training_errors.append(train_mse)\n",
        "    validation_errors.append(val_mse)\n",
        "\n",
        "print(\"\\nTraining and Validation Mean Squared Errors\")\n",
        "\n",
        "for i, degree in enumerate(degrees):\n",
        "    print(\n",
        "        f\"Degree {degree}: \"\n",
        "        f\"Training MSE = {training_errors[i]:.2f}, \"\n",
        "        f\"Validation MSE = {validation_errors[i]:.2f}\"\n",
        "    )\n",
        "\n",
        "plt.figure(figsize=(9, 5))\n",
        "\n",
        "plt.plot(\n",
        "    degrees, training_errors,\n",
        "    marker=\"o\", linewidth=2, label=\"Training Error\"\n",
        ")\n",
        "\n",
        "plt.plot(\n",
        "    degrees, validation_errors,\n",
        "    marker=\"s\", linewidth=2, label=\"Validation Error\"\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Polynomial Degree (Model Complexity)\")\n",
        "plt.ylabel(\"Mean Squared Error\")\n",
        "plt.title(\"Training and Validation Error vs Model Complexity\")\n",
        "plt.xticks(degrees)\n",
        "plt.legend()\n",
        "plt.grid(alpha=0.3)\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# --------------------------------------------------\n",
        "# Task 4: Estimate Bias² and Variance Using Resampling\n",
        "# --------------------------------------------------\n",
        "\n",
        "# Use a fixed validation grid to compare repeated fitted models\n",
        "X_test = np.linspace(500, 3000, 100).reshape(-1, 1)\n",
        "\n",
        "# True underlying relationship without random noise\n",
        "y_true = (\n",
        "    50000\n",
        "    + 100 * X_test.ravel()\n",
        "    + 0.025 * (X_test.ravel() ** 2)\n",
        "    + 150000 * np.sin(X_test.ravel() / 500)\n",
        ")\n",
        "\n",
        "bias_squared_values = []\n",
        "variance_values = []\n",
        "\n",
        "number_of_resamples = 100\n",
        "\n",
        "for degree in degrees:\n",
        "    predictions = []\n",
        "\n",
        "    for _ in range(number_of_resamples):\n",
        "        # Bootstrap sample from the training data\n",
        "        X_boot, y_boot = resample(\n",
        "            X_train, y_train, replace=True\n",
        "        )\n",
        "\n",
        "        model = make_pipeline(\n",
        "            PolynomialFeatures(degree=degree),\n",
        "            LinearRegression()\n",
        "        )\n",
        "\n",
        "        model.fit(X_boot, y_boot)\n",
        "        predictions.append(model.predict(X_test))\n",
        "\n",
        "    predictions = np.array(predictions)\n",
        "\n",
        "    # Average prediction at each test point\n",
        "    mean_prediction = np.mean(predictions, axis=0)\n",
        "\n",
        "    # Bias squared\n",
        "    bias_squared = np.mean(\n",
        "        (mean_prediction - y_true) ** 2\n",
        "    )\n",
        "\n",
        "    # Variance across bootstrap models\n",
        "    variance = np.mean(\n",
        "        np.var(predictions, axis=0)\n",
        "    )\n",
        "\n",
        "    bias_squared_values.append(bias_squared)\n",
        "    variance_values.append(variance)\n",
        "\n",
        "print(\"\\nBias² and Variance Estimates\")\n",
        "\n",
        "for i, degree in enumerate(degrees):\n",
        "    print(\n",
        "        f\"Degree {degree}: \"\n",
        "        f\"Bias² = {bias_squared_values[i]:.2f}, \"\n",
        "        f\"Variance = {variance_values[i]:.2f}\"\n",
        "    )\n",
        "\n",
        "plt.figure(figsize=(9, 5))\n",
        "\n",
        "plt.plot(\n",
        "    degrees, bias_squared_values,\n",
        "    marker=\"o\", linewidth=2, label=\"Bias²\"\n",
        ")\n",
        "\n",
        "plt.plot(\n",
        "    degrees, variance_values,\n",
        "    marker=\"s\", linewidth=2, label=\"Variance\"\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Polynomial Degree\")\n",
        "plt.ylabel(\"Estimated Error\")\n",
        "plt.title(\"Bias² and Variance vs Model Complexity\")\n",
        "plt.xticks(degrees)\n",
        "plt.legend()\n",
        "plt.grid(alpha=0.3)\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# --------------------------------------------------\n",
        "# Task 5: Select the Best Polynomial Degree\n",
        "# --------------------------------------------------\n",
        "\n",
        "best_index = np.argmin(validation_errors)\n",
        "best_degree = degrees[best_index]\n",
        "\n",
        "print(\"\\nBest Model Selection\")\n",
        "print(\"Best Polynomial Degree:\", best_degree)\n",
        "print(\n",
        "    \"Lowest Validation MSE:\",\n",
        "    round(validation_errors[best_index], 2)\n",
        ")\n",
        "\n",
        "if best_degree == 1:\n",
        "    print(\"Interpretation: A linear model gives the lowest validation error.\")\n",
        "elif best_degree == 3:\n",
        "    print(\"Interpretation: Degree 3 provides a good balance of fit and complexity.\")\n",
        "else:\n",
        "    print(\n",
        "        f\"Interpretation: Degree {best_degree} has the lowest validation \"\n",
        "        \"error among the tested models. Check its curve for overfitting.\"\n",
        "    )\n",
        "\n",
        "print(\"\\nExperiment 5 completed successfully!\")\n"
      ]
    }
