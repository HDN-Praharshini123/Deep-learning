        "\n",
        "# CO1 – Mathematical Foundations and Optimization\n",
        "# Experiment 4: Entropy, Cross-Entropy and KL Divergence\n",
        "\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from scipy.stats import entropy\n",
        "\n",
        "# --------------------------------------------------\n",
        "# Given Data: Weather Distribution for 30 Days\n",
        "# --------------------------------------------------\n",
        "\n",
        "# Weather categories: Sunny, Cloudy, Rainy\n",
        "weather = [\"Sunny\", \"Cloudy\", \"Rainy\"]\n",
        "\n",
        "# Observed weather counts over 30 days\n",
        "observed_counts = np.array([15, 9, 6])\n",
        "\n",
        "# True probability distribution\n",
        "P = observed_counts / observed_counts.sum()\n",
        "\n",
        "# Predictions from two forecasting models\n",
        "Q1 = np.array([0.50, 0.30, 0.20])  # Model 1\n",
        "Q2 = np.array([0.60, 0.25, 0.15])  # Model 2\n",
        "\n",
        "print(\"True Distribution P:\", P)\n",
        "print(\"Model 1 Distribution Q1:\", Q1)\n",
        "print(\"Model 2 Distribution Q2:\", Q2)\n",
        "\n",
        "\n",
        "# --------------------------------------------------\n",
        "# Task 1: Entropy of the Observed Distribution\n",
        "# --------------------------------------------------\n",
        "\n",
        "# Entropy measures uncertainty in the true distribution\n",
        "H_P = entropy(P, base=2)\n",
        "\n",
        "print(\"\\nTask 1: Entropy of Observed Weather\")\n",
        "print(f\"Entropy H(P) = {H_P:.4f} bits\")\n",
        "\n",
        "\n",
        "# --------------------------------------------------\n",
        "# Task 2: Cross-Entropy and KL Divergence\n",
        "# --------------------------------------------------\n",
        "\n",
        "# Cross-entropy: H(P, Q) = -sum(P * log2(Q))\n",
        "# KL divergence: DKL(P || Q) = sum(P * log2(P / Q))\n",
        "\n",
        "cross_entropy_Q1 = -np.sum(P * np.log2(Q1))\n",
        "cross_entropy_Q2 = -np.sum(P * np.log2(Q2))\n",
        "\n",
        "kl_Q1 = entropy(P, Q1, base=2)\n",
        "kl_Q2 = entropy(P, Q2, base=2)\n",
        "\n",
        "print(\"\\nTask 2: Model Comparison\")\n",
        "\n",
        "print(\"\\nModel 1:\")\n",
        "print(f\"Cross-Entropy H(P, Q1) = {cross_entropy_Q1:.4f} bits\")\n",
        "print(f\"KL Divergence D(P || Q1) = {kl_Q1:.4f} bits\")\n",
        "\n",
        "print(\"\\nModel 2:\")\n",
        "print(f\"Cross-Entropy H(P, Q2) = {cross_entropy_Q2:.4f} bits\")\n",
        "print(f\"KL Divergence D(P || Q2) = {kl_Q2:.4f} bits\")\n",
        "\n",
        "\n",
        "# --------------------------------------------------\n",
        "# Task 3: Verify Cross-Entropy = Entropy + KL\n",
        "# --------------------------------------------------\n",
        "\n",
        "print(\"\\nTask 3: Verification\")\n",
        "\n",
        "print(\"\\nModel 1:\")\n",
        "print(f\"Cross-Entropy       = {cross_entropy_Q1:.4f}\")\n",
        "print(f\"Entropy + KL         = {H_P + kl_Q1:.4f}\")\n",
        "\n",
        "print(\"\\nModel 2:\")\n",
        "print(f\"Cross-Entropy       = {cross_entropy_Q2:.4f}\")\n",
        "print(f\"Entropy + KL         = {H_P + kl_Q2:.4f}\")\n",
        "\n",
        "print(\"\\nThe values should be equal, apart from rounding.\")\n",
        "\n",
        "\n",
        "# --------------------------------------------------\n",
        "# Task 4: Show KL Divergence is Asymmetric\n",
        "# --------------------------------------------------\n",
        "\n",
        "# KL divergence from P to Q1\n",
        "kl_P_Q1 = entropy(P, Q1, base=2)\n",
        "\n",
        "# KL divergence from Q1 to P\n",
        "kl_Q1_P = entropy(Q1, P, base=2)\n",
        "\n",
        "print(\"\\nTask 4: KL Divergence Asymmetry\")\n",
        "\n",
        "print(f\"D(P || Q1) = {kl_P_Q1:.4f} bits\")\n",
        "print(f\"D(Q1 || P) = {kl_Q1_P:.4f} bits\")\n",
        "\n",
        "if not np.isclose(kl_P_Q1, kl_Q1_P):\n",
        "    print(\"Result: KL divergence is asymmetric.\")\n",
        "else:\n",
        "    print(\"The values are equal for this example.\")\n",
        "\n",
        "\n",
        "# --------------------------------------------------\n",
        "# Task 5: Binary Cross-Entropy Loss\n",
        "# --------------------------------------------------\n",
        "\n",
        "# Actual binary label: 1 means positive, 0 means negative\n",
        "actual_label = 1\n",
        "\n",
        "# Predicted probabilities\n",
        "predicted_probabilities = np.linspace(0.01, 0.99, 200)\n",
        "\n",
        "# Binary cross-entropy loss\n",
        "if actual_label == 1:\n",
        "    losses = -np.log(predicted_probabilities)\n",
        "else:\n",
        "    losses = -np.log(1 - predicted_probabilities)\n",
        "\n",
        "plt.figure(figsize=(8, 5))\n",
        "\n",
        "plt.plot(\n",
        "    predicted_probabilities,\n",
        "    losses,\n",
        "    linewidth=2,\n",
        "    label=f\"Actual label = {actual_label}\"\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Predicted Probability for Positive Class\")\n",
        "plt.ylabel(\"Binary Cross-Entropy Loss\")\n",
        "plt.title(\"Binary Cross-Entropy Loss vs Predicted Probability\")\n",
        "plt.grid(True, alpha=0.3)\n",
        "plt.legend()\n",
        "plt.show()\n",
        "\n",
        "print(\"\\nTask 5:\")\n",
        "print(\"The loss decreases when the predicted probability\")\n",
        "print(\"moves closer to the actual label.\")\n",
        "\n",
        "print(\"\\nExperiment 4 completed successfully!\")\n"
      ]
