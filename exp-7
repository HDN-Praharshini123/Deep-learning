        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Task 1: Perceptron functions\n",
        "def step(z):\n",
        "    return (z >= 0).astype(int)\n",
        "\n",
        "def sigmoid(z):\n",
        "    return 1 / (1 + np.exp(-z))\n",
        "\n",
        "def relu(z):\n",
        "    return np.maximum(0, z)\n",
        "\n",
        "# Task 2: Simulated loan dataset (100 applications)\n",
        "np.random.seed(42)\n",
        "X = np.random.rand(100, 2)\n",
        "y = (X[:, 0] + X[:, 1] >= 1).astype(int)\n",
        "\n",
        "w = np.zeros(2)\n",
        "b = 0\n",
        "lr = 0.1\n",
        "errors = []\n",
        "\n",
        "for epoch in range(20):\n",
        "    err = 0\n",
        "    for i in range(100):\n",
        "        pred = step(np.array([np.dot(X[i], w) + b]))\n",
        "        e = y[i] - pred[0]\n",
        "        w += lr * e * X[i]\n",
        "        b += lr * e\n",
        "        err += int(e != 0)\n",
        "    errors.append(err)\n",
        "    print(\"Epoch\", epoch+1, \"Weights:\", w,\n",
        "          \"Bias:\", round(b, 3), \"Errors:\", err)\n",
        "\n",
        "# Task 3: Decision boundary\n",
        "plt.scatter(X[:, 0], X[:, 1], c=y)\n",
        "xx = np.linspace(0, 1, 100)\n",
        "if abs(w[1]) > 1e-10:\n",
        "    plt.plot(xx, -(w[0]*xx+b)/w[1], color='red')\n",
        "plt.xlabel(\"Credit Score\")\n",
        "plt.ylabel(\"Income-to-Debt Ratio\")\n",
        "plt.title(\"Loan Decision Boundary\")\n",
        "plt.show()\n",
        "\n",
        "# Task 4: XOR perceptron\n",
        "XOR = np.array([[0,0],[0,1],[1,0],[1,1]])\n",
        "Y = np.array([0,1,1,0])\n",
        "w2 = np.zeros(2)\n",
        "b2 = 0\n",
        "\n",
        "for epoch in range(20):\n",
        "    for i in range(4):\n",
        "        p = step(np.array([XOR[i] @ w2 + b2]))[0]\n",
        "        e = Y[i] - p\n",
        "        w2 += lr * e * XOR[i]\n",
        "        b2 += lr * e\n",
        "\n",
        "print(\"XOR actual:\", Y)\n",
        "print(\"XOR predicted:\", step(XOR @ w2 + b2))\n",
        "print(\"A single perceptron cannot learn XOR correctly.\")\n",
        "\n",
        "# Task 5: Activation comparison\n",
        "z = np.array([-3,-2,-1,0,1,2,3])\n",
        "plt.plot(z, step(z), label=\"Step\")\n",
        "plt.plot(z, sigmoid(z), label=\"Sigmoid\")\n",
        "plt.plot(z, relu(z), label=\"ReLU\")\n",
        "plt.xlabel(\"Input\")\n",
        "plt.ylabel(\"Output\")\n",
        "plt.title(\"Activation Functions\")\n",
        "plt.legend()\n",
        "plt.grid()\n",
        "plt.show()"
      ]
