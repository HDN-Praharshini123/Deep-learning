        "\n",
        "# CO1 – Mathematical Foundations and Optimization\n",
        "# Experiment 2: Covariance, Eigenvalues and Eigenvectors Analysis\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# --------------------------------------------------\n",
        "# Task 1: Create and Load the Patient Dataset\n",
        "# --------------------------------------------------\n",
        "\n",
        "np.random.seed(42)\n",
        "\n",
        "# Generate data for 200 patients\n",
        "n = 200\n",
        "\n",
        "hemoglobin = np.random.normal(13.5, 1.5, n)\n",
        "rbc = 4.5 + 0.25 * (hemoglobin - 13.5) + np.random.normal(0, 0.3, n)\n",
        "glucose = np.random.normal(110, 20, n)\n",
        "cholesterol = 180 + 0.6 * (glucose - 110) + np.random.normal(0, 15, n)\n",
        "bmi = np.random.normal(25, 4, n)\n",
        "\n",
        "# Store the data in a Pandas DataFrame\n",
        "df = pd.DataFrame({\n",
        "    \"Hemoglobin\": hemoglobin,\n",
        "    \"RBC_Count\": rbc,\n",
        "    \"Glucose\": glucose,\n",
        "    \"Cholesterol\": cholesterol,\n",
        "    \"BMI\": bmi\n",
        "})\n",
        "\n",
        "print(\"First 5 Patient Records:\")\n",
        "print(df.head())\n",
        "\n",
        "print(\"\\nDataset Shape:\")\n",
        "print(df.shape)\n",
        "\n",
        "# If you have a CSV file, replace the data-generation\n",
        "# section above with:\n",
        "# df = pd.read_csv(\"patient_data.csv\")\n",
        "\n",
        "\n",
        "# --------------------------------------------------\n",
        "# Standardise Each Feature\n",
        "# --------------------------------------------------\n",
        "\n",
        "# Z-score standardisation: (X - mean) / standard deviation\n",
        "X = (df - df.mean()) / df.std(ddof=0)\n",
        "\n",
        "print(\"\\nStandardised Data (First 5 Records):\")\n",
        "print(X.head())\n",
        "\n",
        "\n",
        "# --------------------------------------------------\n",
        "# Task 2: Covariance and Correlation Matrices\n",
        "# --------------------------------------------------\n",
        "\n",
        "cov_matrix = X.cov()\n",
        "corr_matrix = X.corr()\n",
        "\n",
        "print(\"\\nCovariance Matrix:\")\n",
        "print(cov_matrix.round(3))\n",
        "\n",
        "print(\"\\nCorrelation Matrix:\")\n",
        "print(corr_matrix.round(3))\n",
        "\n",
        "\n",
        "# Plot covariance and correlation heatmaps\n",
        "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
        "\n",
        "im1 = axes[0].imshow(cov_matrix, cmap=\"coolwarm\", vmin=-1, vmax=1)\n",
        "axes[0].set_title(\"Covariance Matrix\")\n",
        "axes[0].set_xticks(range(len(X.columns)))\n",
        "axes[0].set_yticks(range(len(X.columns)))\n",
        "axes[0].set_xticklabels(X.columns, rotation=45, ha=\"right\")\n",
        "axes[0].set_yticklabels(X.columns)\n",
        "fig.colorbar(im1, ax=axes[0])\n",
        "\n",
        "im2 = axes[1].imshow(corr_matrix, cmap=\"coolwarm\", vmin=-1, vmax=1)\n",
        "axes[1].set_title(\"Correlation Matrix\")\n",
        "axes[1].set_xticks(range(len(X.columns)))\n",
        "axes[1].set_yticks(range(len(X.columns)))\n",
        "axes[1].set_xticklabels(X.columns, rotation=45, ha=\"right\")\n",
        "axes[1].set_yticklabels(X.columns)\n",
        "fig.colorbar(im2, ax=axes[1])\n",
        "\n",
        "# Add numerical values inside each heatmap\n",
        "for ax, matrix in zip(axes, [cov_matrix, corr_matrix]):\n",
        "    for i in range(matrix.shape[0]):\n",
        "        for j in range(matrix.shape[1]):\n",
        "            ax.text(\n",
        "                j, i, f\"{matrix.iloc[i, j]:.2f}\",\n",
        "                ha=\"center\", va=\"center\", fontsize=8\n",
        "            )\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# --------------------------------------------------\n",
        "# Task 3: Eigenvalues and Eigenvectors\n",
        "# --------------------------------------------------\n",
        "\n",
        "# Use the covariance matrix of the standardised data\n",
        "eigenvalues, eigenvectors = np.linalg.eigh(cov_matrix.values)\n",
        "\n",
        "# Sort eigenvalues from largest to smallest\n",
        "indices = np.argsort(eigenvalues)[::-1]\n",
        "\n",
        "eigenvalues = eigenvalues[indices]\n",
        "eigenvectors = eigenvectors[:, indices]\n",
        "\n",
        "print(\"\\nEigenvalues (Descending Order):\")\n",
        "print(np.round(eigenvalues, 4))\n",
        "\n",
        "print(\"\\nEigenvectors (Columns Correspond to Eigenvalues):\")\n",
        "print(np.round(eigenvectors, 4))\n",
        "\n",
        "\n",
        "# --------------------------------------------------\n",
        "# Task 4: Plot Data in 2-D with Top Two Eigenvectors\n",
        "# --------------------------------------------------\n",
        "\n",
        "# Project the standardised data onto the first two principal directions\n",
        "projected_data = X.values @ eigenvectors[:, :2]\n",
        "\n",
        "plt.figure(figsize=(9, 6))\n",
        "\n",
        "plt.scatter(\n",
        "    projected_data[:, 0],\n",
        "    projected_data[:, 1],\n",
        "    alpha=0.65,\n",
        "    label=\"Patients\"\n",
        ")\n",
        "\n",
        "plt.xlabel(\"First Principal Component (PC1)\")\n",
        "plt.ylabel(\"Second Principal Component (PC2)\")\n",
        "plt.title(\"Patient Data Projected onto First Two Principal Components\")\n",
        "\n",
        "# Draw arrows representing the two principal directions\n",
        "# in the 2-D principal-component coordinate system\n",
        "plt.arrow(\n",
        "    0, 0, 1, 0,\n",
        "    color=\"red\", width=0.015,\n",
        "    head_width=0.12, length_includes_head=True\n",
        ")\n",
        "\n",
        "plt.arrow(\n",
        "    0, 0, 0, 1,\n",
        "    color=\"green\", width=0.015,\n",
        "    head_width=0.12, length_includes_head=True\n",
        ")\n",
        "\n",
        "plt.text(1.05, 0, \"PC1\", color=\"red\", fontsize=11)\n",
        "plt.text(0, 1.05, \"PC2\", color=\"green\", fontsize=11)\n",
        "\n",
        "plt.axhline(0, color=\"gray\", linewidth=0.6)\n",
        "plt.axvline(0, color=\"gray\", linewidth=0.6)\n",
        "plt.grid(True, alpha=0.3)\n",
        "plt.legend()\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# --------------------------------------------------\n",
        "# Task 5: Percentage of Variance Explained\n",
        "# --------------------------------------------------\n",
        "\n",
        "total_variance = np.sum(eigenvalues)\n",
        "variance_percentage = (eigenvalues / total_variance) * 100\n",
        "cumulative_variance = np.cumsum(variance_percentage)\n",
        "\n",
        "variance_table = pd.DataFrame({\n",
        "    \"Principal Component\": [\n",
        "        f\"PC{i+1}\" for i in range(len(eigenvalues))\n",
        "    ],\n",
        "    \"Eigenvalue\": eigenvalues,\n",
        "    \"Variance Explained (%)\": variance_percentage,\n",
        "    \"Cumulative Variance (%)\": cumulative_variance\n",
        "})\n",
        "\n",
        "print(\"\\nPercentage of Variance Explained:\")\n",
        "print(variance_table.round(3).to_string(index=False))\n",
        "\n",
        "# Plot variance explained by each principal component\n",
        "plt.figure(figsize=(8, 5))\n",
        "\n",
        "plt.bar(\n",
        "    variance_table[\"Principal Component\"],\n",
        "    variance_table[\"Variance Explained (%)\"]\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Principal Component\")\n",
        "plt.ylabel(\"Variance Explained (%)\")\n",
        "plt.title(\"Variance Explained by Each Eigenvalue\")\n",
        "plt.grid(axis=\"y\", alpha=0.3)\n",
        "plt.show()\n",
        "\n",
        "print(\"\\nExperiment 2 completed successfully!\")\n"
      ]
    }
